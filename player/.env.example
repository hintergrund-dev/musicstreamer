# Copy to .env. All values are inlined at build time.

# Base URL of the appview (XRPC is served under /xrpc).
PUBLIC_APPVIEW_URL=https://musicstreamer.eu

# Public URL where this app is hosted. It forms the OAuth client_id
# (<PUBLIC_APP_URL>/oauth/client-metadata.json) and the redirect URI.
PUBLIC_APP_URL=https://app.musicstreamer.eu

# Set to 1 for App Store / Google Play builds: hides payment instructions.
PUBLIC_STORE_BUILD=
