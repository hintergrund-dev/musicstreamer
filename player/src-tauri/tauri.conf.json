{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicstreamer",
  "version": "0.1.0",
  "identifier": "eu.musicstreamer.player",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "musicstreamer.eu", "width": 1100, "height": 760, "minWidth": 420, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src https: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["eu.musicstreamer.app"] } },
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://updates.example.invalid/{{target}}/{{arch}}/{{current_version}}"]
    }
  }
}
