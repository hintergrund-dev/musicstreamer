{
  "lexicon": 1,
  "id": "eu.musicstreamer.player.getPlayback",
  "defs": {
    "main": {
      "type": "query",
      "description": "Playback URL for a track. Gated audio carries a short-lived grant and a playId; open audio is a plain URL and counts no stream. Requires auth.",
      "parameters": {
        "type": "params",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          },
          "accept": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxLength": 10,
            "description": "Mime types the client can play. The first source of the track with an accepted type is returned, otherwise the MP3 or AAC baseline source."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "url",
            "mimeType"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "playId": {
              "type": "string"
            },
            "countAfterMs": {
              "type": "integer"
            },
            "mimeType": {
              "type": "string",
              "description": "Mime type of the returned source."
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotSubscribed"
        },
        {
          "name": "ArtistNotVerified"
        },
        {
          "name": "NotLicensedInCountry"
        },
        {
          "name": "TrackUnavailable"
        }
      ]
    }
  }
}
