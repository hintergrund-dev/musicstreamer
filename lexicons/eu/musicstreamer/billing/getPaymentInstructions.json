{
  "lexicon": 1,
  "id": "eu.musicstreamer.billing.getPaymentInstructions",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Stores the listener country and returns the bank transfer instructions with the permanent reference.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "country"
          ],
          "properties": {
            "country": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "ISO 3166-1 alpha-2, EU member state."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "eu.musicstreamer.defs#bankDetails"
        }
      },
      "errors": [
        {
          "name": "UnsupportedCountry"
        }
      ]
    }
  }
}
