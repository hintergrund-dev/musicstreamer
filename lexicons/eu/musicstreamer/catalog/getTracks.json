{
  "lexicon": 1,
  "id": "eu.musicstreamer.catalog.getTracks",
  "defs": {
    "main": {
      "type": "query",
      "description": "Hydrate up to 50 track URIs. Unknown or hidden tracks are omitted.",
      "parameters": {
        "type": "params",
        "required": [
          "uris"
        ],
        "properties": {
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "maxLength": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "tracks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.musicstreamer.defs#trackView"
              }
            }
          }
        }
      }
    }
  }
}
