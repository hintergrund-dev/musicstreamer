{
  "lexicon": 1,
  "id": "eu.musicstreamer.catalog.searchCatalog",
  "defs": {
    "main": {
      "type": "query",
      "description": "Full-text search over artists, releases and tracks.",
      "parameters": {
        "type": "params",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "artists",
            "releases",
            "tracks"
          ],
          "properties": {
            "artists": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.musicstreamer.defs#profileView"
              }
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.musicstreamer.defs#releaseView"
              }
            },
            "tracks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.musicstreamer.defs#trackView"
              }
            }
          }
        }
      }
    }
  }
}
