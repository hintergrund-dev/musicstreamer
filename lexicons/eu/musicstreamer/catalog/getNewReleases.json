{
  "lexicon": 1,
  "id": "eu.musicstreamer.catalog.getNewReleases",
  "defs": {
    "main": {
      "type": "query",
      "description": "Newest releases first.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "releases"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "eu.musicstreamer.defs#releaseView"
              }
            }
          }
        }
      }
    }
  }
}
